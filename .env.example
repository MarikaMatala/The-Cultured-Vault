# Public instance branding. These values are embedded in the browser bundle.
NEXT_PUBLIC_APP_NAME="The Cultured Vault"
NEXT_PUBLIC_APP_TAGLINE="Culture worth discovering. Stories worth remembering."
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Optional six-digit hex brand accents. Invalid values fall back to the built-in palette.
NEXT_PUBLIC_BRAND_BRONZE="#b97b48"
NEXT_PUBLIC_BRAND_SILVER="#c7cbd0"
NEXT_PUBLIC_BRAND_GOLD="#e2bd6f"

# Database, authentication and metadata-provider integrations are not connected yet.
# Do not add real credentials here until a server-side integration is implemented.
# Never expose a database service-role key through a NEXT_PUBLIC_ variable.
